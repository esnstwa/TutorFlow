APP_NAME=TutorFlow
APP_ENV=development
TUTORFLOW_BIND_HOST=127.0.0.1
DATABASE_URL=postgresql+psycopg://tutorflow:tutorflow@localhost:5432/tutorflow
POSTGRES_DB=tutorflow
POSTGRES_USER=tutorflow
POSTGRES_PASSWORD=tutorflow
DEV_TEACHER_EMAIL=anna@tutorflow.local
DEV_STUDENT_EMAIL=student@tutorflow.local
ENABLE_DEV_TEACHER_FALLBACK=false
FILE_STORAGE_PATH=var/uploads
SESSION_LIFETIME_SECONDS=43200
REMEMBER_SESSION_LIFETIME_SECONDS=2592000
